# Копирай като `.dev.vars` за локална работа (файлът е в .gitignore).
# Виж docs/SETUP.md за откъде се взима всяко нещо.

# ── Задължителни ────────────────────────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY="AIza..."
# openssl rand -hex 32
SESSION_SECRET="сложи-тук-дълъг-случаен-низ"

# ── Влизане с Google (по избор) ─────────────────────────────────────────────
# Google Cloud → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:4321/api/auth/google/callback
# GOOGLE_CLIENT_ID="123-abc.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-..."

# ── Писма (по избор) ────────────────────────────────────────────────────────
# Без този ключ връзките за потвърждаване и за нова парола се показват
# в интерфейса вместо да се пращат.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Записки <zdravey@tvoydomain.bg>"

# ── Абонаменти (по избор) ───────────────────────────────────────────────────
# Без тези всички остават на безплатния план.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."          # от `stripe listen`
# STRIPE_PRICE_PLUS_MONTH="price_..."
# STRIPE_PRICE_PLUS_YEAR="price_..."
# STRIPE_PRICE_PRO_MONTH="price_..."
# STRIPE_PRICE_PRO_YEAR="price_..."
# STRIPE_TRIAL_DAYS="14"

# ── Адресът на приложението ─────────────────────────────────────────────────
# Локално се взима от заявката; в production го задай в wrangler.jsonc.
# PUBLIC_SITE_URL="http://localhost:4321"
