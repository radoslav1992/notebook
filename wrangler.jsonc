{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zapiski",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // The audio overview decodes and concatenates tens of MB of PCM, then writes a
  // WAV — real CPU, well past the 30s default. Paid plans allow up to 300000.
  "limits": {
    "cpu_ms": 120000
  },

  // ── D1: notebooks, sources, chunks, messages, notes, studio jobs ──────────
  // No database_id on purpose: wrangler finds or creates the database named
  // below on `wrangler deploy`, so deploying straight from GitHub works with
  // nothing to fill in. Paste the real id here if you prefer it pinned:
  //   wrangler d1 create zapiski   →   "database_id": "<uuid>"
  //
  // The tables themselves are NOT created by deploying. Run once:
  //   wrangler d1 migrations apply zapiski --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zapiski",
      "migrations_dir": "migrations"
    }
  ],

  // ── R2: original uploads + generated audio overviews ─────────────────────
  // Create with:  wrangler r2 bucket create zapiski-files
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "zapiski-files"
    }
  ],

  // ── Vectorize: chunk embeddings for retrieval ─────────────────────────────
  // Create with:
  //   wrangler vectorize create zapiski-chunks --dimensions=1536 --metric=cosine
  //   wrangler vectorize create-metadata-index zapiski-chunks --propertyName=notebookId --type=string
  //   wrangler vectorize create-metadata-index zapiski-chunks --propertyName=sourceId --type=string
  // --dimensions must match EMBED_MODEL: 1536 for gemini-embedding-001, 1024
  // for @cf/baai/bge-m3. Changing the model means a NEW index and re-indexing
  // every source; an existing index cannot be re-sized.
  //
  // Vectorize has NO local emulator. D1 and R2 run locally in .wrangler/state,
  // but this binding only works against the real index in your account.
  //
  // To make search work while developing, add `"remote": true` below and run
  // `wrangler login` first. It is left out by default because with it set,
  // `astro dev` refuses to start at all until you are authenticated — and a
  // fresh clone should come up on `npm run dev` without a Cloudflare account.
  // See docs/SETUP.md.
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "zapiski-chunks"
      // "remote": true
    }
  ],

  // ── Workers AI: needed only if a model below is a Cloudflare one ─────────
  // Nothing to create — the binding is the whole setup.
  "ai": {
    "binding": "AI"
  },

  // ── Cloudflare Email Service: verification, password reset, contact form ──
  // Onboard zapiski.bg as a sending domain first (Email Service → Domains).
  // Until then this can only reach addresses verified in Email Routing, which
  // is enough for the contact form but not for real users. See docs/email.md.
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]

  // ── Variables live in the DASHBOARD, not here ────────────────────────────
  //
  // This file deliberately sets NO vars. Every `wrangler deploy` replaces the
  // worker's plain-text variables with whatever `vars` contains, so a value
  // shipped here would silently revert anything typed into
  // Settings → Variables and Secrets. With the block gone, the dashboard is the
  // only place they live and nothing overwrites it.
  //
  // Each one has a default in code, so a fresh clone runs with none of them set:
  //
  //   CHAT_MODEL        gemini-3.6-flash              src/lib/ai/defaults.ts
  //   CHAT_MODEL_PRO    (unset — paid plans get CHAT_MODEL)
  //   EMBED_MODEL       gemini-embedding-001          src/lib/ai/defaults.ts
  //   TTS_MODEL         gemini-3.1-flash-tts-preview  src/lib/ai/defaults.ts
  //   EMBED_DIMENSIONS  derived from EMBED_MODEL      src/lib/ai/select.ts
  //   RAG_BACKEND       vectorize                     src/lib/api.ts
  //   RESPONSE_LANGUAGE bg                            src/lib/api.ts
  //   EMAIL_FROM        Записки <noreply@zapiski.bg>  src/lib/email.ts
  //   CONTACT_EMAIL     info@zapiski.bg               src/lib/email.ts
  //   CONTACT_TO        dev.radoslav.dodnikov@gmail.com  src/lib/email.ts
  //   PUBLIC_SITE_URL   the request's own host        src/lib/authApi.ts
  //
  // A model name also picks its provider: no slash → Google API with
  // GEMINI_API_KEY, "google/…" or "@cf/…" → Workers AI. See docs/models.md, and
  // GET /api/models for what the deployed key actually accepts.
  //
  // EMBED_MODEL is the one to change carefully: its vector width must match the
  // Vectorize index, and an index cannot be resized. A mismatch fails with a
  // message saying so rather than returning bad results.

  // Secrets (set with `wrangler secret put <NAME>`), see docs/SETUP.md:
  //   GEMINI_API_KEY          — https://aistudio.google.com/apikey; required
  //                             unless every model above is a Cloudflare one,
  //                             and even then YouTube, uploaded audio and
  //                             File Search still need it. See docs/models.md.
  //   SESSION_SECRET          — required, openssl rand -hex 32
  //   GOOGLE_CLIENT_ID        — optional, sign-in with Google
  //   GOOGLE_CLIENT_SECRET    — optional, same
  //   RESEND_API_KEY          — optional, verification + password-reset email
  //   STRIPE_SECRET_KEY       — optional, subscriptions
  //   STRIPE_WEBHOOK_SECRET   — optional, required if Stripe is used
  //   STRIPE_PRICE_PLUS_MONTH / _PLUS_YEAR / _PRO_MONTH / _PRO_YEAR
}
