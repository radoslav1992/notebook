{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zapiski",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // ── D1: notebooks, sources, chunks, messages, notes, studio jobs ──────────
  // No database_id on purpose: wrangler finds or creates the database named
  // below on `wrangler deploy`, so deploying straight from GitHub works with
  // nothing to fill in. Paste the real id here if you prefer it pinned:
  //   wrangler d1 create zapiski   →   "database_id": "<uuid>"
  //
  // The tables themselves are NOT created by deploying. Run once:
  //   wrangler d1 migrations apply zapiski --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zapiski",
      "migrations_dir": "migrations"
    }
  ],

  // ── R2: original uploads + generated audio overviews ─────────────────────
  // Create with:  wrangler r2 bucket create zapiski-files
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "zapiski-files"
    }
  ],

  // ── Vectorize: chunk embeddings for retrieval ─────────────────────────────
  // Create with:
  //   wrangler vectorize create zapiski-chunks --dimensions=1536 --metric=cosine
  //   wrangler vectorize create-metadata-index zapiski-chunks --propertyName=notebookId --type=string
  //   wrangler vectorize create-metadata-index zapiski-chunks --propertyName=sourceId --type=string
  // --dimensions must match EMBED_MODEL: 1536 for gemini-embedding-001, 1024
  // for @cf/baai/bge-m3. Changing the model means a NEW index and re-indexing
  // every source; an existing index cannot be re-sized.
  //
  // Vectorize has NO local emulator. D1 and R2 run locally in .wrangler/state,
  // but this binding only works against the real index in your account.
  //
  // To make search work while developing, add `"remote": true` below and run
  // `wrangler login` first. It is left out by default because with it set,
  // `astro dev` refuses to start at all until you are authenticated — and a
  // fresh clone should come up on `npm run dev` without a Cloudflare account.
  // See docs/SETUP.md.
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "zapiski-chunks"
      // "remote": true
    }
  ],

  // ── Workers AI: needed only if a model below is a Cloudflare one ─────────
  // Nothing to create — the binding is the whole setup.
  "ai": {
    "binding": "AI"
  },

  "vars": {
    // "vectorize" (default) = own RAG over Cloudflare Vectorize with exact page citations.
    // "gemini"              = Google's managed File Search RAG store.
    "RAG_BACKEND": "vectorize",

    // ── Which models, and therefore which provider ────────────────────────
    //
    // EDIT THESE HERE, NOT IN THE DASHBOARD. Every `wrangler deploy` replaces
    // the worker's plain-text variables with this block, so a value typed into
    // Settings → Variables and Secrets is silently reverted on the next push.
    // (Secrets are not touched — only plain variables.) `GET /api/models` shows
    // which models the deployed key actually accepts.
    //
    // The name picks the provider, because the identifiers never overlap:
    //   no slash        → Google Generative Language API, needs GEMINI_API_KEY
    //   "google/…"      → Workers AI partner model, billed by Cloudflare
    //   "@cf/…"         → Cloudflare's own model
    // See src/lib/ai/select.ts. To move everything to Cloudflare:
    //   "CHAT_MODEL":  "google/gemini-3.6-flash",
    //   "EMBED_MODEL": "@cf/baai/bge-m3",        // 1024 dims — needs its own index
    //   "TTS_MODEL":   "google/gemini-3.1-flash-tts",
    //
    // Google retires models EARLIER than the announced shutdown date:
    // gemini-2.5-flash and gemini-2.5-pro already answer "no longer available
    // to new users" on new keys, though both are listed for 2026-10-16. Check
    // /api/models before trusting anything here.
    "CHAT_MODEL": "gemini-3.6-flash",
    // Offered in Settings to paid plans only. Left unset because a wrong id
    // here reaches users as a broken model picker; add yours from /api/models:
    //   "CHAT_MODEL_PRO": "gemini-3.1-pro",
    "EMBED_MODEL": "gemini-embedding-001",
    "TTS_MODEL": "gemini-3.1-flash-tts",

    // Vector width. Derived from EMBED_MODEL (see ai/select.ts); set only if a
    // model is missing from that table. Must match the Vectorize index.
    // "EMBED_DIMENSIONS": "1024",

    "RESPONSE_LANGUAGE": "bg",

    // Адресът, на който приложението живее. Задай го след първия deploy —
    // от него се правят връзките в писмата и redirect_uri за Google.
    // "PUBLIC_SITE_URL": "https://zapiski.tvoydomain.bg",

    // Подател на писмата; трябва да е на потвърден в Resend домейн.
    "EMAIL_FROM": "Записки <onboarding@resend.dev>"
  }

  // Secrets (set with `wrangler secret put <NAME>`), see docs/SETUP.md:
  //   GEMINI_API_KEY          — https://aistudio.google.com/apikey; required
  //                             unless every model above is a Cloudflare one,
  //                             and even then YouTube, uploaded audio and
  //                             File Search still need it. See docs/models.md.
  //   SESSION_SECRET          — required, openssl rand -hex 32
  //   GOOGLE_CLIENT_ID        — optional, sign-in with Google
  //   GOOGLE_CLIENT_SECRET    — optional, same
  //   RESEND_API_KEY          — optional, verification + password-reset email
  //   STRIPE_SECRET_KEY       — optional, subscriptions
  //   STRIPE_WEBHOOK_SECRET   — optional, required if Stripe is used
  //   STRIPE_PRICE_PLUS_MONTH / _PLUS_YEAR / _PRO_MONTH / _PRO_YEAR
}
