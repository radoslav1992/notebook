{
  "name": "zapiski",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Записки — тетрадки с източници и въпроси. Всеки отговор идва с препратка.",
  "scripts": {
    "build": "astro build",
    "check": "astro check",
    "console-schema": "node scripts/build-console-schema.mjs",
    "db:migrate": "wrangler d1 migrations apply zapiski --remote",
    "db:migrate:local": "wrangler d1 migrations apply zapiski --local",
    "deploy": "astro build && wrangler deploy",
    "dev": "astro dev",
    "fixtures": "node tests/fixtures/build.mjs",
    "preview": "wrangler dev",
    "test": "node tests/run.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.0",
    "@astrojs/preact": "^6.0.2",
    "astro": "^7.2.0",
    "preact": "^10.29.8",
    "unpdf": "^1.8.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.120.0",
    "tsx": "^4.20.3"
  }
}
