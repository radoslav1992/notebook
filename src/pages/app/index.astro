---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import Chrome from '../../components/Chrome.astro';
import HomeView from '../../components/HomeView';
import { getSettings, listNotebooks } from '../../lib/db';
import { getEntitlement } from '../../lib/limits';
import '../../styles/app.css';

export const prerender = false;

const user = Astro.locals.user;
const [notebooks, entitlement, settings] = await Promise.all([
  listNotebooks(env.DB, user.id),
  getEntitlement(env.DB, user.id),
  getSettings(env.DB, user.id),
]);

const max = entitlement.plan.limits.notebooks;
const claimed = Number(Astro.url.searchParams.get('claimed') ?? '0') || 0;
---

<Base title="Записки — тетрадките ти">
  <Chrome user={user} active="home" />
  <HomeView
    notebooks={notebooks}
    useCase={settings.useCase}
    displayName={user.displayName}
    maxNotebooks={Number.isFinite(max) ? max : null}
    claimed={claimed}
    client:load
  />
</Base>
