---
import Base from '~/layouts/Base.astro';
import NotebookApp from '~/components/NotebookApp';
import SetupNotice from '~/components/SetupNotice.astro';
import * as db from '~/lib/db';
import { ConfigError, getRuntime } from '~/lib/env';
import { getOwnerId } from '~/lib/session';
import type { NotebookState } from '~/lib/client';

const { id } = Astro.params;

let state: NotebookState | null = null;
let setupError: string | null = null;

try {
  const app = getRuntime(Astro);
  const ownerId = await getOwnerId(Astro);
  const notebook = id ? await db.getNotebook(app.env.DB, id, ownerId) : null;

  if (!notebook) return Astro.redirect('/');

  const [sources, messages, notes, audio] = await Promise.all([
    db.listSources(app.env.DB, notebook.id),
    db.listMessages(app.env.DB, notebook.id),
    db.listNotes(app.env.DB, notebook.id),
    db.listAudio(app.env.DB, notebook.id),
  ]);
  state = { notebook, sources, messages, notes, audio };
} catch (err) {
  setupError =
    err instanceof ConfigError || err instanceof Error
      ? err.message
      : 'The app is not configured yet.';
}
---

<Base title={state ? `${state.notebook.title} — Notebook` : 'Notebook'}>
  {
    setupError || !state ? (
      <SetupNotice message={setupError ?? 'Could not load this notebook.'} />
    ) : (
      <NotebookApp initialState={state} client:load />
    )
  }
</Base>
