---
import Base from '~/layouts/Base.astro';
import NotebookGrid from '~/components/NotebookGrid';
import SetupNotice from '~/components/SetupNotice.astro';
import * as db from '~/lib/db';
import { ConfigError, getRuntime } from '~/lib/env';
import { getOwnerId } from '~/lib/session';

let notebooks: Array<Awaited<ReturnType<typeof db.listNotebooks>>[number] & { sourceCount: number }> =
  [];
let setupError: string | null = null;

try {
  const app = getRuntime(Astro);
  const ownerId = await getOwnerId(Astro);
  const rows = await db.listNotebooks(app.env.DB, ownerId);
  const counts = await db.countSourcesByNotebook(
    app.env.DB,
    rows.map((n) => n.id),
  );
  notebooks = rows.map((n) => ({ ...n, sourceCount: counts[n.id] ?? 0 }));
} catch (err) {
  setupError =
    err instanceof ConfigError || err instanceof Error
      ? err.message
      : 'The app is not configured yet.';
}
---

<Base title="Notebook — your sources, understood">
  {
    setupError ? (
      <SetupNotice message={setupError} />
    ) : (
      <NotebookGrid initial={notebooks} client:load />
    )
  }
</Base>
