{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", ".wrangler"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": false,
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    }
  }
}
